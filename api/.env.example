# Application
PORT=5000
NODE_ENV=development

# URLs

CLIENT_URL=https://your-domain.dev
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# JWT (Authentication)
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d

# Cloudinary (File Uploads)
CLOUDINARY_APP_NAME=your_cloudinary_app_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mailgun API
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_FROM="Your App Name <no-reply@your_domain.dev>"

# SMTP (Fallback option for Email)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=no-reply@your_domain.dev
SMTP_PASS=your_smtp_password
SMTP_FROM="Your App Name <no-reply@your_domain.dev>"

# Domain (used if SMTP_FROM not set)
DOMAIN=your-domain.dev

RECIPIENT_EMAIL=info@your_domain.dev